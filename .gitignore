# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Environment files may contain machine-specific paths; only the examples are
# committed.
.env
.env.local
backend/.env
frontend/.env.local

# Node / Next.js
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Application runtime data: uploaded studies, results and cached slice arrays.
# This is user data and can be large, so it is never committed.
outputs/app_data/

# The source dataset and every layer derived from it. SPIDER is licensed
# research data containing per-patient radiological gradings, so it is
# downloaded by scripts/01_extract.py and never committed. data/raw/images.zip
# alone is 3.5 GB, which GitHub would reject outright.
data/raw/
data/extracted/
data/processed/

# Model checkpoints are large binaries. outputs/models/findings/ is small and
# regenerated by scripts/18_export_finding_models.py, so it is also excluded to
# keep the repository free of binaries.
outputs/checkpoints/
outputs/models/

# Rendered MRI slices, overlays and figures. These are pictures of patient
# anatomy. Every one is regenerated by the scripts in scripts/.
outputs/visualizations/

# Tabular data derived per patient, per series or per slice: measurement tables,
# volume inventories, per-slice metrics. The .md and .json reports beside them
# are the research deliverables and ARE committed - they carry the aggregate
# findings without carrying the per-patient rows.
outputs/**/*.csv

# Per-subject radiological assessment reports: patient_id, series ids,
# ground-truth Pfirrmann and Modic gradings and per-disc measurements for
# individual subjects, in .json, .md and .txt form alike. This is generated
# patient-specific analysis data. Regenerated by scripts/08_generate_reports.py.
outputs/reports/finding_assessments/

# OS noise
Thumbs.db
.DS_Store
