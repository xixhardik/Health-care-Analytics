# Backend configuration. Copy to backend/.env and adjust if needed.
#
# Every value below has a project-relative default, so a fresh clone runs without
# editing anything. Paths may be relative to the repository root or absolute.
# Do not commit machine-specific absolute paths.

# --- models ---------------------------------------------------------------
# The validated Sprint 3 segmentation checkpoint. Sprint 4 (width 32) exists but
# measured worse on every Dice class and on disc indexing, so it is not served.
MODEL_CHECKPOINT=outputs/checkpoints/sprint3_coverage/best_val_dice.pt

# Persisted finding estimators, written by scripts/18_export_finding_models.py
FINDING_MODEL_DIR=outputs/models/findings

# The published Sprint 5 post-processing configuration. Read at startup so the
# served pipeline cannot drift from the configuration that was validated.
SPRINT5_PARAMS=outputs/reports/sprint5_indexing/test_results.json

# --- storage --------------------------------------------------------------
# Uploads, results and cached slice arrays. One directory per analysis.
STORAGE_DIR=outputs/app_data

# --- runtime --------------------------------------------------------------
# Slices per forward pass. Lower this if memory is tight.
INFERENCE_BATCH_SIZE=4

# Concurrent analyses. Inference is CPU-bound, so 1 is the sensible default on a
# laptop; raising it mostly just makes each job slower.
JOB_WORKERS=1

# Hard limit on a single analysis before it is marked failed.
JOB_TIMEOUT_SECONDS=1800

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
